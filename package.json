{
  "name": "@fringeworks/style-layouts-adornment",
  "version": "0.3.0",
  "private": true,
  "description": "CSS layouts for placing labels, badges, and other adornments around or over a main element",
  "keywords": [
    "css",
    "style",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/style-layouts-adornment.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./styles.scss": "./src/styles.scss",
    "./styles.css": "./src/styles.scss",
    "./*.scss": "./src/*/styles.scss",
    "./*.css": "./src/*/styles.scss",
    "./with-css": "./src/with-css/index.ts",
    "./with-css/*": "./src/with-css/*/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/style-utils": "^0.9.0",
    "@fringeworks/utils": "^0.11.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@fringeworks/dev": "^0.13.1",
    "@fringeworks/types": "^0.9.2",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/web-components-vite": "^10.3.6",
    "@tsdown/css": "^0.23.1",
    "@types/node": "^25.9.9",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chroma-js": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.3.6",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2",
    "playwright": "^1.60.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.0",
    "storybook": "^10.3.6",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
