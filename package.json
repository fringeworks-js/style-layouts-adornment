{
  "name": "@fringeworks/style-layouts-adornment",
  "version": "0.1.0",
  "private": true,
  "description": "CSS layouts for placing labels, badges, and other adornments around or over a main element",
  "keywords": [
    "css",
    "style",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/style-layouts-adornment.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./styles.scss": "./src/styles.scss",
    "./styles.css": "./src/styles.scss",
    "./*.scss": "./src/*/styles.scss",
    "./*.css": "./src/*/styles.scss",
    "./with-css": "./src/with-css/index.ts",
    "./with-css/*": "./src/with-css/*/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build-storybook": "storybook build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.js"
  },
  "dependencies": {
    "@fringeworks/style-utils": "^0.8.0",
    "@fringeworks/types": "^0.8.0",
    "@fringeworks/utils": "^0.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@fringeworks/dev": "^0.8.0",
    "@fringeworks/rollup-plugin-dist-package": "^0.8.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/web-components-vite": "^10.3.6",
    "@tsdown/css": "^0.22.0",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.8",
    "chroma-js": "^3.2.0",
    "eslint": "^10.3.0",
    "fast-glob": "^3.3.3",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.99.0",
    "storybook": "^10.3.6",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
